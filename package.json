{
  "name": "@joesonw/localio",
  "version": "0.0.1",
  "description": "A local Twilio simulator: voice, SMS, recordings, all on SQLite.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "localio": "dist/index.js"
  },
  "files": [
    "dist",
    "public",
    "seed.example.json"
  ],
  "license": "MIT",
  "author": "Qiaosen Huang",
  "homepage": "https://github.com/joesonw/localio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joesonw/localio.git"
  },
  "bugs": {
    "url": "https://github.com/joesonw/localio/issues"
  },
  "keywords": [
    "twilio",
    "twiml",
    "media-streams",
    "sms",
    "voice",
    "mock",
    "simulator",
    "local-development",
    "sqlite"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/db && cp src/db/*.sql dist/db/",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && tsx --test src/*.test.ts src/**/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.3.0",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.12.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.19.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "twilio": "^5.4.0",
    "typescript": "^5.5.3"
  }
}
